# Supabase (required for login / workspace)
# Get these from your project: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend API base URL (user/account info after sign-in). Dev and prod can point to different hosts.
VITE_API_BASE_URL=https://api.karapi.io
VITE_API_BASE_URL_DEV=https://dev.api.karapi.io
